<Window x:Class="CollageDesigner.HomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Collage Designer" Width="640" Height="465" MinWidth="580" MinHeight="420" WindowStartupLocation="CenterScreen" Background="#171B20" Foreground="White">
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="#20262D" Padding="14"><TextBlock HorizontalAlignment="Right"><Run Text="Software Development by "/><Hyperlink NavigateUri="https://www.energeticedge.lk/" RequestNavigate="Credit_Navigate">Energetic Edge (Pvt) Ltd</Hyperlink></TextBlock></Border>
  <Menu DockPanel.Dock="Top" Background="#20262D" Foreground="White"><MenuItem Header="Tools"><MenuItem Header="Album Style Trainer" Click="Trainer_Click"/></MenuItem></Menu>
  <StackPanel Margin="38" VerticalAlignment="Center">
   <TextBlock Text="CREATE" FontSize="24" FontWeight="Bold" Margin="0,0,0,18"/>
   <Button Content="Create Collage" Click="Collage_Click" Height="55" Margin="0,0,0,12" FontSize="18" Background="#33404D" Foreground="White"/>
   <Button Content="Create Album" Click="Album_Click" Height="55" Margin="0,0,0,16" FontSize="18" Background="#AF754F" Foreground="White"/>
   <TextBlock x:Name="TrainerState" Text="Album style training is available under Tools." Foreground="#B7C2CC" Margin="0,5,0,10"/>
   <Button Content="Teach My Album Style" Click="Trainer_Click" Width="210" Height="38" HorizontalAlignment="Left" Background="#33404D" Foreground="White"/>
  </StackPanel>
 </DockPanel>
</Window>
