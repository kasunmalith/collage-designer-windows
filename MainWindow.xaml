<Window x:Class="CollageDesigner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Collage Designer" Width="1500" Height="920" MinWidth="1050" MinHeight="690" Background="#171B20" Foreground="#ECEFF2" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_KeyDown" PreviewKeyUp="Window_KeyUp" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#303943"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#292F37"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#4A5560"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4E8EB"/></Style>
 </Window.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#20262D" Foreground="White"><MenuItem Header="_File"><MenuItem Header="Import Photos" Click="Import_Click"/><MenuItem Header="Open Project" Click="Open_Click"/><Separator/><MenuItem Header="Save Project" Click="Save_Click"/><MenuItem Header="Save Project As" Click="SaveAs_Click"/><Separator/><MenuItem Header="Export" Click="Export_Click"/></MenuItem><MenuItem Header="_View"><MenuItem Header="Dark / Light" Click="Theme_Click"/></MenuItem></Menu>
  <Grid DockPanel.Dock="Top" Background="#20262D"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="12,7"><TextBlock Text="COLLAGE DESIGNER" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Content="Import Photos" Click="Import_Click"/><Button Content="Open Project" Click="Open_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/><Button Content="◀ Layout" Click="Prev_Click"/><Button Content="Layout ▶" Click="Next_Click"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="QuickSaveCheck" Content="Quick save" Foreground="White" VerticalAlignment="Center" Margin="4,0" Checked="QuickSave_Changed" Unchecked="QuickSave_Changed"/><Button Content="Export JPG / PNG / PSD" Background="#AF754F" FontWeight="Bold" Margin="10" Click="Export_Click"/></StackPanel></Grid>
  <Border DockPanel.Dock="Bottom" Background="#20262D" Padding="12,7"><Grid><TextBlock x:Name="Status" Text="Ready. Import 1–12 JPG photos."/><TextBlock HorizontalAlignment="Right"><Run Text="Software Development by "/><Hyperlink NavigateUri="https://www.energeticedge.lk/" RequestNavigate="Credit_Navigate">Energetic Edge (Pvt) Ltd</Hyperlink></TextBlock></Grid></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#212830" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="PHOTOS" FontSize="12" FontWeight="Bold" Foreground="#AEB9C2" Margin="4,4,4,10"/><Button Content="+ Add JPG photos" Click="Import_Click"/><Button Content="Remove All Photos" Click="RemoveAll_Click" Background="#6A3538"/><TextBlock x:Name="CountText" Text="0 / 12" Margin="5,8"/><CheckBox x:Name="MoveUsedPhotosCheck" Margin="5,4,5,10" Checked="MoveUsedPhotos_Changed" Unchecked="MoveUsedPhotos_Changed"><TextBlock Text="After export, move originals to ‘used photos’ and clear them here" TextWrapping="Wrap" Width="190"/></CheckBox><TextBlock Text="Drag a photo onto another to insert it and shift the photos between them. Drag onto empty space to move its frame. Shift+click selects multiple frames; Ctrl+drag moves only the image crop. Click outside the collage to clear selection. Drag a frame side to resize." TextWrapping="Wrap" Foreground="#AEB9C2" Margin="5,5,5,12"/></StackPanel><ListBox x:Name="PhotoList" SelectionMode="Extended" Background="Transparent" BorderThickness="0" SelectionChanged="PhotoList_SelectionChanged" PreviewMouseMove="PhotoList_PreviewMouseMove"/></DockPanel></Border>
   <Grid Grid.Column="1" Background="#11151A" MouseLeftButtonDown="PreviewHost_Down"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="PreviewLabel" Grid.Row="0" Text="Preview" HorizontalAlignment="Center" Margin="10" Foreground="#AEB9C2"/><Border Grid.Row="1" Margin="24" Background="#292F37"><Grid x:Name="PreviewHost" Background="Transparent" SizeChanged="PreviewHost_SizeChanged" MouseLeftButtonDown="PreviewHost_Down"><Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/><Canvas x:Name="HitCanvas" Focusable="True" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" MouseLeftButtonDown="Canvas_Down" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up" MouseWheel="Canvas_Wheel" DragOver="Canvas_DragOver" DragLeave="Canvas_DragLeave" Drop="Canvas_Drop" AllowDrop="True"/></Grid></Border></Grid>
   <ScrollViewer Grid.Column="2" Background="#212830" VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="CANVAS SIZE" FontWeight="Bold" Margin="3,8"/><TextBlock Text="Size preset" Margin="3,6,3,0"/><ComboBox x:Name="CanvasPresetBox" SelectionChanged="CanvasPreset_Changed"><ComboBoxItem Content="Custom size" IsSelected="True"/><ComboBoxItem Content="4 × 6 inches"/><ComboBoxItem Content="8 × 12 inches"/><ComboBoxItem Content="9 × 16 inches"/><ComboBoxItem Content="4 × 5 inches"/><ComboBoxItem Content="5 × 5 inches"/></ComboBox><ComboBox x:Name="UnitBox" SelectionChanged="Size_Changed"><ComboBoxItem Content="Pixels" IsSelected="True"/><ComboBoxItem Content="Inches"/></ComboBox><TextBlock Text="Width" Margin="3,6,3,0"/><TextBox x:Name="WidthBox" Text="2160" LostFocus="Size_Changed" KeyDown="SizeBox_KeyDown"/><TextBlock Text="Height" Margin="3,6,3,0"/><TextBox x:Name="HeightBox" Text="2700" LostFocus="Size_Changed" KeyDown="SizeBox_KeyDown"/><TextBlock Text="DPI (inches)" Margin="3,6,3,0"/><TextBox x:Name="DpiBox" Text="300" LostFocus="Size_Changed" KeyDown="SizeBox_KeyDown"/><Button Content="Apply Canvas Size" Click="Size_Changed" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal"><Button Content="Portrait" Click="Portrait_Click"/><Button Content="Landscape" Click="Landscape_Click"/></StackPanel><TextBlock x:Name="ResolutionText" Margin="3,7" Text="2160 × 2700 px" Foreground="#AEB9C2"/>
   <Separator Margin="0,12"/><TextBlock Text="LAYOUT" FontWeight="Bold" Margin="3,4"/><TextBlock Text="Layout section" Margin="3,5,3,0"/><ComboBox x:Name="LayoutCategoryBox" SelectionChanged="LayoutCategory_Changed"><ComboBoxItem Content="Normal layouts" IsSelected="True"/><ComboBoxItem Content="Random space layouts"/></ComboBox><TextBlock Text="Design option" Margin="3,7,3,0"/><ComboBox x:Name="LayoutOptionBox" DisplayMemberPath="Name" SelectionChanged="LayoutOption_Changed"/><TextBlock x:Name="LayoutText" Text="Import photos" Margin="3,5"/><StackPanel Orientation="Horizontal"><Button Content="Previous ↑" Click="Prev_Click"/><Button Content="Next ↓" Click="Next_Click"/></StackPanel>
   <Separator Margin="0,12"/><TextBlock Text="PHOTO GAP  0–500 px" FontWeight="Bold" Margin="3,4"/><StackPanel Orientation="Horizontal"><Slider x:Name="GapSlider" Minimum="0" Maximum="500" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" Width="190" ValueChanged="Gap_Changed"/><TextBox x:Name="GapBox" Width="52" Text="3" LostFocus="GapBox_Changed"/></StackPanel><Button x:Name="EqualGapsButton" Content="Equal Photo Gaps" Click="EqualGaps_Click" Visibility="Collapsed" HorizontalAlignment="Left"/><TextBlock Text="OUTER MARGIN  0–1000 px" FontWeight="Bold" Margin="3,12,3,4"/><StackPanel Orientation="Horizontal"><Slider x:Name="MarginSlider" Minimum="0" Maximum="1000" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="190" ValueChanged="Margin_Changed"/><TextBox x:Name="MarginBox" Width="52" Text="0" LostFocus="MarginBox_Changed"/></StackPanel><TextBlock Text="Background" Margin="3,10,3,0"/><ComboBox x:Name="BackgroundBox" SelectionChanged="Background_Changed"><ComboBoxItem Content="White" IsSelected="True"/><ComboBoxItem Content="Light Gray"/><ComboBoxItem Content="Black"/><ComboBoxItem Content="Custom…"/></ComboBox>
   <Separator Margin="0,12"/><TextBlock Text="SELECTED PHOTO" FontWeight="Bold" Margin="3,4"/><TextBlock x:Name="SelectedText" Text="Click a photo in the collage" TextWrapping="Wrap" Margin="3,5"/><TextBlock Text="Zoom (1×–5×)" Margin="3,8,3,0"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="5" Value="1" ValueChanged="Zoom_Changed"/><StackPanel Orientation="Horizontal"><Button Content="−" Click="ZoomOut_Click"/><Button Content="+" Click="ZoomIn_Click"/><Button Content="Reset Photo Position" Click="Reset_Click"/></StackPanel><Button x:Name="CenterPhotoButton" Content="Center Photo in Collage" Click="CenterPhoto_Click" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal"><Button Content="Replace Photo" Click="Replace_Click"/><Button Content="Remove Photo" Click="Remove_Click"/></StackPanel>
   <Separator Margin="0,12"/><TextBlock Text="JPEG QUALITY" FontWeight="Bold" Margin="3,4"/><StackPanel Orientation="Horizontal"><Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="95" TickFrequency="1" IsSnapToTickEnabled="True" Width="200" ValueChanged="Quality_Changed"/><TextBlock x:Name="QualityValue" Text="95" Margin="8,0"/></StackPanel><ProgressBar x:Name="Progress" Height="7" Margin="3,14" Minimum="0" Maximum="100" Visibility="Collapsed"/></StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
