<Window x:Class="CollageDesigner.TrainingReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review Album Training" Width="1250" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#171B20" Foreground="White">
 <Window.Resources><Style TargetType="ListBox"><Setter Property="Background" Value="#292F37"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="#20262D" Padding="10"><Grid><TextBlock x:Name="StatusText" Text="Select a sheet to review."/><TextBlock HorizontalAlignment="Right"><Run Text="Software Development by "/><Hyperlink NavigateUri="https://www.energeticedge.lk/" RequestNavigate="Credit_Navigate">Energetic Edge (Pvt) Ltd</Hyperlink></TextBlock></Grid></Border>
  <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Background="#212830"><TextBlock Text="SHEETS" FontWeight="Bold" Margin="10"/><ListBox x:Name="SheetList" SelectionChanged="Sheet_Changed"/></StackPanel>
   <Grid Grid.Column="1" x:Name="PreviewHost" Background="#292F37" Margin="10,0" SizeChanged="Preview_SizeChanged"><Image x:Name="SheetImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/><Canvas x:Name="RegionCanvas" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="Canvas_Down" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up"/></Grid>
   <ScrollViewer Grid.Column="2" Background="#212830"><StackPanel Margin="10"><TextBlock Text="PHOTO REGIONS" FontWeight="Bold"/><ListBox x:Name="RegionList" Height="220" SelectionChanged="Region_Changed"/><TextBlock Text="Original photo" Margin="0,12,0,3"/><ComboBox x:Name="SourcePhotoBox" DisplayMemberPath="Name"/><Button Content="Assign Photo to Region" Click="Assign_Click"/><Button Content="Add Missing Photo Area" Click="Add_Click"/><Button Content="Remove Selected Region" Click="Remove_Click"/><Button Content="Validate Sheet" Click="Validate_Click" Background="#AF754F"/><TextBlock Text="Click a region to inspect its match. To correct a rectangle, remove it, then draw it again. Select its original JPG and click Assign. Validate after every region is matched." TextWrapping="Wrap" Foreground="#B7C2CC" Margin="0,16"/></StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</Window>
