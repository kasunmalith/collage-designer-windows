<Window x:Class="CollageDesigner.TrainerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Album Style Trainer" Width="1100" Height="780" MinWidth="850" MinHeight="600" WindowStartupLocation="CenterOwner" Background="#171B20" Foreground="White">
 <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#303943"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3"/></Style><Style TargetType="ListBox"><Setter Property="Background" Value="#292F37"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style></Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="#20262D" Padding="10"><Grid><TextBlock x:Name="StatusText" Text="Select the All Albums folder."/><TextBlock HorizontalAlignment="Right"><Run Text="Software Development by "/><Hyperlink NavigateUri="https://www.energeticedge.lk/" RequestNavigate="Credit_Navigate">Energetic Edge (Pvt) Ltd</Hyperlink></TextBlock></Grid></Border>
  <StackPanel DockPanel.Dock="Top" Margin="16"><TextBlock Text="MY ALBUM STYLE" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="StatsText" Foreground="#B7C2CC" Margin="0,6,0,10"/><WrapPanel><Button Content="View Folder Structure Example" Click="Example_Click"/><Button Content="Select All Albums Folder" Click="SelectFolder_Click" Background="#AF754F"/><Button x:Name="AnalyzeButton" Content="Analyze All Albums" Click="Analyze_Click"/><Button x:Name="PauseButton" Content="Pause Analysis" Click="Pause_Click"/><Button Content="Cancel Analysis" Click="Cancel_Click"/><Button Content="Review Selected Album" Click="Review_Click"/><Button Content="Train / Update Style" Click="Train_Click"/><CheckBox x:Name="ProblemsOnly" Content="Review Problems Only" Foreground="White" Checked="Problems_Changed" Unchecked="Problems_Changed" VerticalAlignment="Center" Margin="12,0"/></WrapPanel><ProgressBar x:Name="Progress" Height="8" Margin="0,10" Minimum="0" Maximum="100"/></StackPanel>
  <Grid Margin="16,0,16,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="AlbumList" SelectionChanged="Album_Changed" Background="#212830" Foreground="White"/>
   <StackPanel Grid.Column="1" Background="#212830" Margin="12,0,0,0"><TextBlock Text="TRAINING ALBUM" FontWeight="Bold"/><TextBlock x:Name="DetailsText" TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Sheet files" FontWeight="Bold"/><ListBox x:Name="SheetList" Height="360"/></StackPanel>
  </Grid>
 </DockPanel>
</Window>
