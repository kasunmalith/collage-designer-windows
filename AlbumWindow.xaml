<Window x:Class="CollageDesigner.AlbumWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Create Album" Width="1450" Height="900" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#171B20" Foreground="White" PreviewKeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#303943"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#292F37"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#292F37"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Window.Resources>
 <DockPanel>
  <Border DockPanel.Dock="Bottom" Background="#20262D" Padding="10"><Grid><TextBlock x:Name="StatusText" Text="Choose an album size, sheet count, and selected photos."/><TextBlock HorizontalAlignment="Right"><Run Text="Software Development by "/><Hyperlink NavigateUri="https://www.energeticedge.lk/" RequestNavigate="Credit_Navigate">Energetic Edge (Pvt) Ltd</Hyperlink></TextBlock></Grid></Border>
  <Grid>
  <StackPanel x:Name="SetupPanel" Margin="26" VerticalAlignment="Center" HorizontalAlignment="Center" Width="620">
   <TextBlock Text="CREATE PRINTED ALBUM" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
   <TextBlock Text="1. Choose full spread size"/><ComboBox x:Name="SizeBox" SelectionChanged="Setup_Changed" Margin="0,5,0,12"/>
   <TextBlock Text="2. Number of full spreads (10–35)"/><TextBox x:Name="SheetCountBox" Text="20" TextChanged="Setup_Changed"/>
   <TextBlock Text="Print DPI" Margin="0,8,0,0"/><TextBox x:Name="DpiBox" Text="300" TextChanged="Setup_Changed"/>
   <TextBlock Text="3. Import photographs already selected by the photographer" Margin="0,10,0,3"/><Button Content="Import Selected JPG Photos" Click="Import_Click" HorizontalAlignment="Left"/>
   <TextBlock x:Name="SetupSummary" TextWrapping="Wrap" Margin="0,14,0,14" Foreground="#B7C2CC"/>
   <StackPanel Orientation="Horizontal"><Button Content="Generate Album" Click="Generate_Click" Background="#AF754F" FontWeight="Bold"/><Button Content="Open Album Project" Click="Open_Click"/></StackPanel>
  </StackPanel>
  <Grid x:Name="EditorPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <WrapPanel Background="#20262D" Margin="0,0,0,4"><Button Content="Save Album" Click="Save_Click"/><Button Content="Open Album" Click="Open_Click"/><Button Content="Export All Sheets" Click="Export_Click" Background="#AF754F"/><Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/><Button Content="Previous Layout" Click="PreviousLayout_Click"/><Button Content="Next Layout" Click="NextLayout_Click"/><Button Content="Approve Sheet" Click="Approve_Click"/><Button Content="Save Final Album To My Style" Click="SaveStyle_Click"/><CheckBox x:Name="FoldCheck" Content="Show Fold Guide" IsChecked="True" Checked="Fold_Changed" Unchecked="Fold_Changed" VerticalAlignment="Center" Margin="10,0"/></WrapPanel>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Background="#212830" Margin="4"><TextBlock Text="ALBUM SHEETS" FontWeight="Bold" Margin="10"/><ListBox x:Name="SheetList" SelectionChanged="Sheet_Changed" AllowDrop="True" DragOver="SheetList_DragOver" Drop="SheetList_Drop" Height="480"/><TextBlock x:Name="UsageText" TextWrapping="Wrap" Margin="10"/></StackPanel>
    <Grid Grid.Column="1" Background="#292F37" x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged"><Image x:Name="SpreadImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/><Canvas x:Name="HitCanvas" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="Canvas_Down" MouseMove="Canvas_Move" MouseLeftButtonUp="Canvas_Up"/><Border x:Name="FoldGuide" Width="2" Background="#FFFFA600" HorizontalAlignment="Center" IsHitTestVisible="False"/><Border x:Name="FoldSafeGuide" Width="12" BorderBrush="#77FFA600" BorderThickness="1,0" HorizontalAlignment="Center" IsHitTestVisible="False"/></Grid>
    <ScrollViewer Grid.Column="2" Background="#212830" Margin="4"><StackPanel Margin="8"><TextBlock Text="PHOTOS ON SHEET" FontWeight="Bold" Margin="4"/><ListBox x:Name="PhotoList" Height="280" SelectionChanged="Photo_Changed" PreviewMouseLeftButtonDown="PhotoList_Down" PreviewMouseMove="PhotoList_Drag" AllowDrop="True" Drop="PhotoList_Drop"/><Button Content="Move to Previous Sheet" Click="MovePrevious_Click"/><Button Content="Move to Next Sheet" Click="MoveNext_Click"/><Button Content="Remove to Unassigned" Click="Unassign_Click"/><TextBlock Text="UNASSIGNED PHOTOS" FontWeight="Bold" Margin="4,14,4,4"/><ListBox x:Name="UnassignedList" Height="100"/><Button Content="Add to Current Sheet" Click="Assign_Click"/><TextBlock Text="Selected Photo Zoom" Margin="4,14,4,2"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="5" Value="1" ValueChanged="Zoom_Changed"/><Button Content="Reset Crop" Click="ResetCrop_Click"/><TextBlock Text="Selected Frame Size" Margin="4,10,4,2"/><WrapPanel><Button Content="Width −" Tag="W-" Click="FrameSize_Click"/><Button Content="Width +" Tag="W+" Click="FrameSize_Click"/><Button Content="Height −" Tag="H-" Click="FrameSize_Click"/><Button Content="Height +" Tag="H+" Click="FrameSize_Click"/></WrapPanel><TextBlock Text="Fold safe zone (inches)" Margin="4,10,4,2"/><TextBox x:Name="FoldSafeBox" Text="0.5" LostFocus="FoldSafe_Changed" KeyDown="FoldSafe_KeyDown"/><TextBlock Text="Drag inside a photo to pan its crop. Ctrl+drag moves its frame. Drag a photo name onto a sheet to move it. Drag onto another photo name to change its order." TextWrapping="Wrap" Foreground="#B7C2CC" Margin="4,14"/></StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  </Grid>
 </DockPanel>
</Window>
